digraph ECU_FreeRTOS {
    rankdir=TB
    graph [fontname="Helvetica" splines=ortho bgcolor="white" pad=0.5]
    node  [fontname="Helvetica" fontsize=12 style="filled,rounded" shape=box margin="0.2,0.15"]
    edge  [fontname="Helvetica" fontsize=10]

    // ─── Tâches critiques (prio 5) ───────────────────────────────
    PID [
        label="Tâche PID\nPrio 5 | 100 ms strict\nStack 2048 B"
        fillcolor="#FCEBEB" color="#A32D2D" fontcolor="#501313"
    ]
    FAILSAFE [
        label="Tâche Failsafe\nPrio 5 | événementielle\nStack 1024 B"
        fillcolor="#FCEBEB" color="#A32D2D" fontcolor="#501313"
    ]

    // ─── Tâches communication (prio 3-4) ─────────────────────────
    UART_RX [
        label="Tâche UART RX\nPrio 4 | asynchrone (ISR)\nStack 2048 B"
        fillcolor="#EEEDFE" color="#534AB7" fontcolor="#26215C"
    ]
    PARSER [
        label="Tâche Parser\nPrio 3 | bloquée sur queue\nStack 3072 B"
        fillcolor="#EEEDFE" color="#534AB7" fontcolor="#26215C"
    ]
    TX [
        label="Tâche TX\nPrio 4 | bloquée sur queue\nStack 2048 B"
        fillcolor="#EEEDFE" color="#534AB7" fontcolor="#26215C"
    ]

    // ─── Tâche basse priorité ─────────────────────────────────────
    STATS [
        label="Tâche Stats\nPrio 1 | 1 s périodique\nStack 2048 B"
        fillcolor="#F1EFE8" color="#5F5E5A" fontcolor="#2C2C2A"
    ]

    // ─── Mécanismes IPC ───────────────────────────────────────────
    Q_BYTES [
        label="Queue octets\n256 items · uint8"
        shape=rectangle style="filled" fillcolor="#E1F5EE" color="#0F6E56" fontcolor="#04342C"
    ]
    Q_OUTPUT [
        label="Queue OUTPUT\n5 items · float"
        shape=rectangle style="filled" fillcolor="#E1F5EE" color="#0F6E56" fontcolor="#04342C"
    ]
    Q_TX [
        label="Queue TX\n10 items · frame"
        shape=rectangle style="filled" fillcolor="#E1F5EE" color="#0F6E56" fontcolor="#04342C"
    ]
    MUTEX_VARS [
        label="Mutex + vars partagées\nsetpoint · speed · mode · output"
        shape=rectangle style="filled" fillcolor="#FAEEDA" color="#854F0B" fontcolor="#412402"
    ]
    MUTEX_TX [
        label="Mutex UART TX\n1 seul écrivain à la fois"
        shape=rectangle style="filled" fillcolor="#FAEEDA" color="#854F0B" fontcolor="#412402"
    ]
    SEM_GPIO [
        label="Semaphore GPIO\nISR → Failsafe"
        shape=diamond style="filled" fillcolor="#FAECE7" color="#993C1D" fontcolor="#4A1B0C"
    ]

    // ─── Source externe ───────────────────────────────────────────
    GPIO_EXT [
        label="GPIO externe\n(bouton / signal erreur)"
        shape=ellipse fillcolor="#F1EFE8" color="#5F5E5A" fontcolor="#2C2C2A"
    ]
    UART_BUS [
        label="Bus UART\n115200 bauds"
        shape=ellipse fillcolor="#F1EFE8" color="#5F5E5A" fontcolor="#2C2C2A"
    ]

    // ─── Flux de données ──────────────────────────────────────────
    UART_BUS   -> UART_RX   [label="octets bruts"        color="#534AB7"]
    UART_RX    -> Q_BYTES   [label="xQueueSend"          color="#0F6E56"]
    Q_BYTES    -> PARSER    [label="xQueueReceive"       color="#0F6E56"]
    PARSER     -> MUTEX_VARS [label="xSemaphoreTake\n(écriture setpoint/speed/mode)" color="#854F0B" style=dashed]
    PARSER     -> FAILSAFE  [label="reset watchdog"      color="#A32D2D" style=dashed]

    PID        -> MUTEX_VARS [label="xSemaphoreTake\n(lecture setpoint/speed)" color="#854F0B" style=dashed]
    PID        -> Q_OUTPUT  [label="xQueueSend\n(float output)" color="#0F6E56"]
    Q_OUTPUT   -> TX        [label="xQueueReceive"       color="#0F6E56"]

    STATS      -> Q_TX      [label="xQueueSend\n(trame STATS)" color="#0F6E56"]
    Q_TX       -> TX        [label="xQueueReceive"       color="#0F6E56"]

    FAILSAFE   -> Q_TX      [label="xQueueSend\n(trame ALERT 0x85)" color="#A32D2D"]
    TX         -> MUTEX_TX  [label="xSemaphoreTake"      color="#854F0B" style=dashed]
    MUTEX_TX   -> UART_BUS  [label="uart_write"          color="#5F5E5A"]

    GPIO_EXT   -> SEM_GPIO  [label="ISR"                 color="#A32D2D"]
    SEM_GPIO   -> FAILSAFE  [label="xSemaphoreGiveFromISR" color="#A32D2D"]

    // ─── Regroupement visuel ──────────────────────────────────────
    subgraph cluster_tasks {
        label="Tâches FreeRTOS"
        fontname="Helvetica" fontsize=13
        style=dashed color="#888780"
        UART_RX; PARSER; PID; TX; FAILSAFE; STATS
    }
    subgraph cluster_ipc {
        label="Mécanismes IPC"
        fontname="Helvetica" fontsize=13
        style=dashed color="#1D9E75"
        Q_BYTES; Q_OUTPUT; Q_TX; MUTEX_VARS; MUTEX_TX; SEM_GPIO
    }
}
